<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="#211D2A">
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ink &amp; Quill"
        android:textColor="#EEE6F5"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1" />
    <TextView
        android:id="@+id/widget_words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 words today"
        android:textColor="#C7B5E0"
        android:textSize="24sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/widget_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Open your studio"
        android:textColor="#AAA2B5"
        android:textSize="12sp" />
</LinearLayout>
